{
  "$schema": "https://cdn.jsdelivr.net/npm/@inkly-org/interactive-demo/dist/schema/demo.config.json",
  "id": "acmeShowcase",
  "version": 1,
  "title": "Acme Analytics in a minute",
  "subtitle": "Find the drop-off, save the audience, bring the team in.",
  "background": {
    "type": "color",
    "from": "#f6f6f4",
    "to": "#d9d7d2"
  },
  "theme": {
    "preset": "mono",
    "tokens": {
      "primary": "#17151a"
    },
    "brand": {
      "name": "Acme Analytics",
      "logoHref": "https://example.com"
    }
  },
  "chrome": {
    "controls": "full",
    "autoplay": true,
    "branding": true
  },
  "chapters": [
    {
      "id": "understand",
      "title": "See what's happening",
      "stepIds": [
        "overview",
        "funnel",
        "breakdown"
      ]
    },
    {
      "id": "act",
      "title": "Act on it",
      "stepIds": [
        "segments"
      ]
    },
    {
      "id": "share",
      "title": "Bring the team in",
      "stepIds": [
        "settings",
        "invite"
      ]
    }
  ],
  "steps": [
    {
      "kind": "cover",
      "id": "cover-intro",
      "widgets": [
        {
          "type": "headline",
          "id": "headline-intro",
          "logo": {
            "src": "assets/acme-mark.svg",
            "alt": "Acme",
            "height": 40
          },
          "title": "Know exactly where your users drop off",
          "description": "Turn the events you already send into funnels and audiences your whole team can act on.",
          "cta": {
            "label": "Start the tour",
            "action": {
              "type": "next"
            },
            "animation": "shimmer"
          },
          "secondaryCta": {
            "label": "Skip to team sharing",
            "action": {
              "type": "chapter",
              "chapterId": "share"
            },
            "animation": "none",
            "background": "#efeeec",
            "textColor": "#17151a"
          },
          "image": {
            "src": "assets/02-funnel.webp",
            "alt": "An Acme Analytics activation funnel",
            "naturalWidth": 1440,
            "naturalHeight": 900,
            "position": "right",
            "layout": "hero"
          }
        }
      ],
      "advance": {
        "trigger": "click"
      }
    },
    {
      "kind": "content",
      "id": "overview",
      "label": "Your numbers, live",
      "background": {
        "type": "image",
        "src": "assets/01-overview.webp",
        "alt": "The Acme Analytics overview: four KPIs, active users by month, top events and recent reports",
        "naturalWidth": 1440,
        "naturalHeight": 900
      },
      "script": "This is your workspace. Every event from your app and your warehouse lands here, live. When a number moves, one click turns it into a funnel.",
      "voiceover": {
        "src": "assets/vo-overview.mp3",
        "duration": 9384
      },
      "captions": [
        {
          "id": "overview_c1",
          "start": 0,
          "end": 1553,
          "text": "This is your workspace."
        },
        {
          "id": "overview_c2",
          "start": 1553,
          "end": 5738,
          "text": "Every event from your app and your warehouse lands here, live."
        },
        {
          "id": "overview_c3",
          "start": 5738,
          "end": 9384,
          "text": "When a number moves, one click turns it into a funnel."
        }
      ],
      "advance": {
        "trigger": "click"
      },
      "annotations": [
        {
          "id": "overview-new-funnel",
          "type": "message",
          "variant": "cursor",
          "x": 0.9493,
          "y": 0.1189,
          "text": "Spot a change? Build a funnel from events you already send.",
          "showMessage": true
        },
        {
          "id": "overview-owners",
          "type": "blur",
          "x": 0.312,
          "y": 0.784,
          "w": 0.09,
          "h": 0.13,
          "intensity": 10
        }
      ]
    },
    {
      "kind": "content",
      "id": "funnel",
      "label": "Find the drop-off",
      "background": {
        "type": "image",
        "src": "assets/02-funnel.webp",
        "alt": "A five-step activation funnel with the biggest drop-off between visiting and signing up",
        "naturalWidth": 1440,
        "naturalHeight": 900
      },
      "script": "Funnels show exactly where people leave. Here, more than half of your visitors go before they ever sign up.",
      "voiceover": {
        "src": "assets/vo-funnel.mp3",
        "duration": 6744
      },
      "captions": [
        {
          "id": "funnel_c1",
          "start": 0,
          "end": 2545,
          "text": "Funnels show exactly where people leave."
        },
        {
          "id": "funnel_c2",
          "start": 2545,
          "end": 6744,
          "text": "Here, more than half of your visitors go before they ever sign up."
        }
      ],
      "transform": {
        "zoom": 1.22,
        "x": 0.95,
        "y": 0.42
      },
      "advance": {
        "trigger": "click"
      },
      "annotations": [
        {
          "id": "funnel-signup",
          "type": "message",
          "variant": "pointer",
          "x": 0.578,
          "y": 0.3144,
          "text": "**54%** of visitors leave before signing up. That's your biggest lever.",
          "anchor": "top"
        },
        {
          "id": "funnel-label",
          "type": "text",
          "x": 0.69,
          "y": 0.625,
          "text": "← fix this one first",
          "fontSize": 18,
          "color": "#17151a"
        }
      ]
    },
    {
      "kind": "content",
      "id": "breakdown",
      "label": "Break it down",
      "background": {
        "type": "video",
        "src": "assets/03-breakdown.webm",
        "posterSrc": "assets/03-breakdown-poster.webp",
        "alt": "Scrolling to the funnel's breakdown by segment and the weekly sign-up rate",
        "naturalWidth": 1440,
        "naturalHeight": 900,
        "autoplay": true,
        "muted": true
      },
      "script": "Scroll for the why: sales-assisted sign-ups convert at nearly three times the self-serve rate, and the weekly trend is climbing.",
      "advance": {
        "trigger": "click"
      },
      "annotations": [
        {
          "id": "breakdown-save",
          "type": "message",
          "variant": "cursor",
          "x": 0.8951,
          "y": 0.6956,
          "text": "Keep the people who converted as an audience you can reuse.",
          "showMessage": true,
          "anchor": "top"
        }
      ]
    },
    {
      "kind": "content",
      "id": "segments",
      "label": "Save the audience",
      "background": {
        "type": "image",
        "src": "assets/04-segments.webp",
        "alt": "Saved segments, with audiences Acme suggests below the list",
        "naturalWidth": 1440,
        "naturalHeight": 900
      },
      "script": "Turn any funnel step into a segment the whole team can reuse, or start from one Acme suggests.",
      "advance": {
        "trigger": "click"
      },
      "annotations": [
        {
          "id": "segments-suggested",
          "type": "message",
          "variant": "area",
          "x": 0.1764,
          "y": 0.5272,
          "w": 0.4914,
          "h": 0.1956,
          "text": "Acme suggests audiences worth a look, like people who connected data but never built a report.",
          "anchor": "right"
        }
      ]
    },
    {
      "kind": "content",
      "id": "settings",
      "label": "Invite your team",
      "background": {
        "type": "image",
        "src": "assets/05-settings.webp",
        "alt": "Workspace settings: general options, members and connected sources",
        "naturalWidth": 1440,
        "naturalHeight": 900
      },
      "script": "Seats, roles and data sources live in one place, so everyone works from the same numbers.",
      "advance": {
        "trigger": "click"
      },
      "annotations": [
        {
          "id": "settings-members",
          "type": "message",
          "variant": "callout",
          "x": 0.672,
          "y": 0.3,
          "text": "Everyone sees the same numbers. You choose who can edit, and who can only look.",
          "anchor": "left"
        }
      ]
    },
    {
      "kind": "content",
      "id": "invite",
      "label": "Send the invite",
      "background": {
        "type": "image",
        "src": "assets/06-invite.webp",
        "alt": "The invite dialog with a teammate's address and the Editor role",
        "naturalWidth": 1440,
        "naturalHeight": 900
      },
      "script": "Invite a teammate in seconds. They land on this same workspace, with nothing to set up.",
      "voiceover": {
        "src": "assets/vo-invite.mp3",
        "duration": 5736
      },
      "captions": [
        {
          "id": "invite_c1",
          "start": 0,
          "end": 1934,
          "text": "Invite a teammate in seconds."
        },
        {
          "id": "invite_c2",
          "start": 1934,
          "end": 5736,
          "text": "They land on this same workspace, with nothing to set up."
        }
      ],
      "advance": {
        "trigger": "click"
      },
      "annotations": [
        {
          "id": "invite-send",
          "type": "message",
          "variant": "cursor",
          "x": 0.6118,
          "y": 0.6589,
          "text": "Send it. They land on this workspace, ready to go.",
          "showMessage": true
        }
      ]
    },
    {
      "kind": "cover",
      "id": "cover-form",
      "widgets": [
        {
          "type": "form",
          "id": "walkthrough",
          "title": "Want a walkthrough on your own data?",
          "description": "We'll connect Acme to your events and walk your team through it. Thirty minutes, no slides.",
          "fields": [
            {
              "id": "name",
              "label": "Name",
              "placeholder": "Your name",
              "required": true
            },
            {
              "id": "email",
              "label": "Work email",
              "placeholder": "Work email",
              "required": true
            },
            {
              "id": "team",
              "label": "Team size",
              "type": "dropdown",
              "options": [
                {
                  "value": "1-10",
                  "label": "1–10"
                },
                {
                  "value": "11-50",
                  "label": "11–50"
                },
                {
                  "value": "51-200",
                  "label": "51–200"
                },
                {
                  "value": "201+",
                  "label": "201 or more"
                }
              ]
            }
          ],
          "submit": {
            "label": "Book my walkthrough",
            "action": {
              "type": "next"
            },
            "animation": "shimmer"
          }
        }
      ],
      "advance": {
        "trigger": "click"
      }
    },
    {
      "kind": "cover",
      "id": "cover-outro",
      "widgets": [
        {
          "type": "headline",
          "id": "headline-outro",
          "title": "That's Acme in a minute",
          "titleColor": "#ffffff",
          "description": "This tour was recorded from the product with interactive-demo, written up in its editor and shipped as a static folder. Make one for yours.",
          "descriptionColor": "#b6b3ad",
          "cta": {
            "label": "Make a tour like this",
            "action": {
              "type": "url",
              "href": "https://github.com/inkly-ai/interactive-demo"
            },
            "animation": "shimmer",
            "background": "#ffffff",
            "textColor": "#17151a"
          },
          "secondaryCta": {
            "label": "Watch again",
            "action": {
              "type": "restart"
            },
            "animation": "none",
            "background": "#2b292e",
            "textColor": "#ffffff"
          },
          "image": {
            "src": "assets/04-segments.webp",
            "alt": "Saved segments in Acme Analytics",
            "naturalWidth": 1440,
            "naturalHeight": 900,
            "position": "left",
            "layout": "hero"
          }
        }
      ],
      "background": {
        "type": "color",
        "color": "#17151a"
      },
      "advance": {
        "trigger": "click"
      }
    }
  ]
}
